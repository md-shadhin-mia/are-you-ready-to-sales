# Environment Configuration

# Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_platform
POSTGRES_PORT=5435
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/ecommerce_platform?schema=public"

# Redis 7
REDIS_HOST="localhost"
REDIS_PORT=6382
REDIS_URL="redis://localhost:6382"

# MinIO S3 Object Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="platform-media"
MINIO_PUBLIC_URL="http://localhost:9100"

# Authentication & Security
JWT_ACCESS_SECRET="dev-access-super-secret-key-at-least-32-chars-long"
JWT_REFRESH_SECRET="dev-refresh-super-secret-key-at-least-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API & Domains
PORT=4000
API_URL="http://localhost:4000"
PLATFORM_DOMAIN="platform.local"
NODE_ENV="development"

# Comma-separated list of origins allowed for credentialed CORS requests.
# Required in production; in non-production, an unset value allows any origin for local dev convenience.
CORS_ALLOWED_ORIGINS=""

# Admin Portal Operations
# 64 hex chars (32 bytes) for AES-256-GCM encryption of gateway credentials and CMS secrets.
# Generate with: openssl rand -hex 32   (required when NODE_ENV=production)
SECRETS_ENCRYPTION_KEY=
# HMAC-SHA256 secret for courier webhooks; per-provider overrides: COURIER_WEBHOOK_SECRET_STEADFAST, _PATHAO, _REDX, _PAPERFLY
COURIER_WEBHOOK_SECRET=
# Enables in-process schedulers (hourly report materialized-view refresh)
ENABLE_SCHEDULED_JOBS=false
REPORTS_REFRESH_INTERVAL_MS=3600000
