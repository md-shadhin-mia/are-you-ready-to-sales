# ==============================================================================
# Production Environment Variables Configuration
# ==============================================================================

# External Port exposed by Nginx Gateway (default: 81)
HTTP_PORT=81

# Platform Domain for Multi-Tenancy (e.g. yourdomain.com or platform.local)
PLATFORM_DOMAIN=platform.local

# PostgreSQL 16 Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-database-password
POSTGRES_DB=ecommerce_platform

# SeaweedFS S3 Object Storage Credentials
STORAGE_ACCESS_KEY=replace-with-storage-admin-user
STORAGE_SECRET_KEY=replace-with-storage-admin-secret-at-least-16-chars
STORAGE_BUCKET_NAME=platform-media
STORAGE_PUBLIC_URL=http://localhost:81/storage
# Backward compatibility aliases
MINIO_ACCESS_KEY=replace-with-storage-admin-user
MINIO_SECRET_KEY=replace-with-storage-admin-secret-at-least-16-chars
MINIO_BUCKET_NAME=platform-media
MINIO_PUBLIC_URL=http://localhost:81/storage

# Security & JWT Tokens (Must be unique strings, minimum 32 characters)
JWT_ACCESS_SECRET=replace-with-unique-jwt-access-secret-minimum-32-chars
JWT_REFRESH_SECRET=replace-with-unique-jwt-refresh-secret-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 64 hex characters (32 bytes) for AES-256-GCM encryption of gateway credentials
# Generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Courier Webhook Secret
COURIER_WEBHOOK_SECRET=replace-with-strong-courier-webhook-secret

# Schedulers & Background Jobs
ENABLE_SCHEDULED_JOBS=true
REPORTS_REFRESH_INTERVAL_MS=3600000
