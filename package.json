{
  "name": "commercial-ecommerce-platform",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate:dev",
    "db:seed": "pnpm --filter @repo/db seed",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml --profile tunnels down",
    "docker:up:tunnels": "docker compose -f docker-compose.dev.yml --profile tunnels up -d && bash scripts/tunnel-urls.sh",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:deploy": "bash scripts/deploy.sh",
    "docker:hub:pull": "docker compose pull",
    "docker:hub:up": "docker compose up -d",
    "docker:hub:down": "docker compose down",
    "docker:hub:logs": "docker compose logs -f",
    "tunnel:urls": "bash scripts/tunnel-urls.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "tunnel": "bash scripts/start-tunnels.sh",
    "tunnel:storefront": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:student": "cloudflared tunnel --url http://localhost:3001",
    "tunnel:admin": "cloudflared tunnel --url http://localhost:3002",
    "tunnel:all": "bash scripts/start-tunnels.sh full"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.2",
    "typescript": "^5.5.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
