datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  INSTITUTE_ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  TRAINING_MANAGER
  SUPPORT_AGENT
  STUDENT
  CUSTOMER
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  MAINTENANCE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
  REFUNDED
}

enum LedgerEntryType {
  ORDER_PROFIT
  PLATFORM_FEE
  PAYOUT_WITHDRAWAL
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  role         UserRole  @default(STUDENT)
  isActive     Boolean   @default(true) @map("is_active")
  isVerified   Boolean   @default(false) @map("is_verified")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  stores       Store[]

  @@map("users")
}

model Store {
  id                String         @id @default(uuid())
  studentId         String         @map("student_id")
  student           User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  storeName         String         @map("store_name")
  slug              String         @unique
  customDomain      String?        @unique @map("custom_domain")
  logoUrl           String?        @map("logo_url")
  faviconUrl        String?        @map("favicon_url")
  themeConfig       Json           @default("{}") @map("theme_config")
  brandingInfo      Json           @default("{}") @map("branding_info")
  status            StoreStatus    @default(DRAFT)
  ratingAvg         Decimal        @default(0.0) @db.Decimal(3, 2) @map("rating_avg")
  totalReviewsCount Int            @default(0) @map("total_reviews_count")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  storeProducts     StoreProduct[]
  customers         Customer[]
  orders            Order[]
  ledgerEntries     LedgerEntry[]

  @@index([studentId])
  @@index([status])
  @@map("stores")
}

model Category {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  parentId       String?         @map("parent_id")
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryHierarchy")
  masterProducts MasterProduct[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model MasterProduct {
  id                String          @id @default(uuid())
  sku               String          @unique
  title             String
  categoryId        String          @map("category_id")
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  basePrice         Decimal         @db.Decimal(10, 2) @map("base_price")
  stockQuantity     Int             @default(0) @map("stock_quantity")
  masterDescription String          @db.Text @map("master_description")
  masterImages      String[]        @default([]) @map("master_images")
  isActive          Boolean         @default(true) @map("is_active")
  ratingAvg         Decimal         @default(0.0) @db.Decimal(3, 2) @map("rating_avg")
  totalReviewsCount Int             @default(0) @map("total_reviews_count")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  storeProducts     StoreProduct[]
  orderItems        OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("master_products")
}

model StoreProduct {
  id                String        @id @default(uuid())
  storeId           String        @map("store_id")
  store             Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  masterProductId   String        @map("master_product_id")
  masterProduct     MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  sellingPrice      Decimal       @db.Decimal(10, 2) @map("selling_price")
  compareAtPrice    Decimal?      @db.Decimal(10, 2) @map("compare_at_price")
  customTitle       String?       @map("custom_title")
  customDescription String?       @db.Text @map("custom_description")
  customImages      String[]      @default([]) @map("custom_images")
  tags              String[]      @default([])
  isFeatured        Boolean       @default(false) @map("is_featured")
  isVisible         Boolean       @default(true) @map("is_visible")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  orderItems        OrderItem[]

  @@unique([storeId, masterProductId])
  @@index([storeId])
  @@index([isVisible])
  @@map("store_products")
}

model Customer {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fullName          String    @map("full_name")
  phone             String
  email             String?
  addresses         Json      @default("[]")
  totalOrdersCount  Int       @default(0) @map("total_orders_count")
  totalSpend        Decimal   @default(0.0) @db.Decimal(10, 2) @map("total_spend")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  orders            Order[]

  @@unique([storeId, phone])
  @@index([storeId])
  @@map("customers")
}

model Order {
  id                 String       @id @default(uuid())
  storeId            String       @map("store_id")
  store              Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customerId         String       @map("customer_id")
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderNumber        String       @unique @map("order_number")
  subtotal           Decimal      @db.Decimal(10, 2)
  shippingFee        Decimal      @default(0.0) @db.Decimal(10, 2) @map("shipping_fee")
  discountAmount     Decimal      @default(0.0) @db.Decimal(10, 2) @map("discount_amount")
  totalAmount        Decimal      @db.Decimal(10, 2) @map("total_amount")
  totalBaseCost      Decimal      @default(0.0) @db.Decimal(10, 2) @map("total_base_cost")
  platformCommission Decimal      @default(0.0) @db.Decimal(10, 2) @map("platform_commission")
  paymentFee         Decimal      @default(0.0) @db.Decimal(10, 2) @map("payment_fee")
  studentNetProfit   Decimal      @default(0.0) @db.Decimal(10, 2) @map("student_net_profit")
  status             OrderStatus  @default(PENDING_PAYMENT)
  paymentMethod      String       @default("COD") @map("payment_method")
  paymentStatus      String       @default("UNPAID") @map("payment_status")
  shippingAddress    Json         @map("shipping_address")
  trackingNumber     String?      @map("tracking_number")
  courierName        String?      @map("courier_name")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  items              OrderItem[]
  ledgerEntries      LedgerEntry[]

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeProductId   String?       @map("store_product_id")
  storeProduct     StoreProduct? @relation(fields: [storeProductId], references: [id], onDelete: SetNull)
  masterProductId  String        @map("master_product_id")
  masterProduct    MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  quantity         Int
  unitBasePrice    Decimal       @db.Decimal(10, 2) @map("unit_base_price")
  unitSellingPrice Decimal       @db.Decimal(10, 2) @map("unit_selling_price")
  totalPrice       Decimal       @db.Decimal(10, 2) @map("total_price")
  createdAt        DateTime      @default(now()) @map("created_at")

  @@map("order_items")
}

model LedgerEntry {
  id           String          @id @default(uuid())
  storeId      String          @map("store_id")
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  orderId      String?         @map("order_id")
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  entryType    LedgerEntryType @map("entry_type")
  amount       Decimal         @db.Decimal(10, 2)
  balanceAfter Decimal         @db.Decimal(10, 2) @map("balance_after")
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([storeId])
  @@map("ledger_entries")
}
