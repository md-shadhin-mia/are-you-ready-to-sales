enum StockMovementType {
  PURCHASE_RECEIPT
  ORDER_FULFILLMENT
  EXCHANGE_HOLD
  EXCHANGE_RELEASE
  EXCHANGE_DISPATCH
  RETURN_RESTOCK
  PURCHASE_RETURN
  WRITE_OFF
  AUDIT_ADJUSTMENT
}

model StockMovement {
  id              String            @id @default(uuid())
  masterProductId String            @map("master_product_id")
  masterProduct   MasterProduct     @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  movementType    StockMovementType @map("movement_type")
  // Signed delta applied to physical on-hand quantity.
  quantity        Int
  // Signed delta applied to reserved quantity.
  reservedDelta   Int               @default(0) @map("reserved_delta")
  onHandAfter     Int               @map("on_hand_after")
  reservedAfter   Int               @map("reserved_after")
  // Available (on hand - reserved) after the movement.
  balanceAfter    Int               @map("balance_after")
  referenceType   String?           @map("reference_type")
  referenceId     String?           @map("reference_id")
  performedById   String?           @map("performed_by_id")
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([masterProductId, createdAt])
  @@index([movementType])
  @@map("stock_movements")
}

