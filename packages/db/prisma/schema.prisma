  email             String?
  contractStartDate DateTime? @map("contract_start_date")
  contractEndDate   DateTime? @map("contract_end_date")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InvoiceMatchStatus {
  PENDING
  MATCHED
  DISCREPANCY
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  poNumber             String              @unique @map("po_number")
  supplierId           String              @map("supplier_id")
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status               PurchaseOrderStatus @default(DRAFT)
  totalCost            Decimal             @default(0.0) @map("total_cost") @db.Decimal(12, 2)
  paidAmount           Decimal             @default(0.0) @map("paid_amount") @db.Decimal(12, 2)
  expectedDate         DateTime?           @map("expected_date")
  notes                String?
  invoiceNumber        String?             @map("invoice_number")
  invoiceAmount        Decimal?            @map("invoice_amount") @db.Decimal(12, 2)
  matchStatus          InvoiceMatchStatus  @default(PENDING) @map("match_status")
  matchVariancePercent Decimal?            @map("match_variance_percent") @db.Decimal(7, 2)
  createdById          String?             @map("created_by_id")
  issuedAt             DateTime?           @map("issued_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]
  purchaseReturns PurchaseReturn[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
