datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  INSTITUTE_ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  TRAINING_MANAGER
  SUPPORT_AGENT
  STUDENT
  CUSTOMER
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  MAINTENANCE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
  REFUNDED
}

enum LedgerEntryType {
  ORDER_PROFIT
  PLATFORM_FEE
  PAYOUT_WITHDRAWAL
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum FunnelEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_INITIATED
  ORDER_COMPLETED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         UserRole @default(STUDENT)
  isActive     Boolean  @default(true) @map("is_active")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stores            Store[]
  studentLevel      StudentLevel?
  studentProgresses StudentProgress[]

  @@map("users")
}

model Store {
  id                    String      @id @default(uuid())
  studentId             String      @map("student_id")
  student               User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  storeName             String      @map("store_name")
  slug                  String      @unique
  customDomain          String?     @unique @map("custom_domain")
  logoUrl               String?     @map("logo_url")
  faviconUrl            String?     @map("favicon_url")
  themeConfig           Json        @default("{}") @map("theme_config")
  brandingInfo          Json        @default("{}") @map("branding_info")
  status                StoreStatus @default(DRAFT)
  ratingAvg             Decimal     @default(0.0) @map("rating_avg") @db.Decimal(3, 2)
  totalReviewsCount     Int         @default(0) @map("total_reviews_count")
  responseRatePercent   Decimal     @default(100.00) @map("response_rate_percent") @db.Decimal(5, 2)
  repeatCustomerPercent Decimal     @default(0.00) @map("repeat_customer_percent") @db.Decimal(5, 2)
  completedOrdersCount  Int         @default(0) @map("completed_orders_count")
  bannerText            String?     @map("banner_text")
  bannerLink            String?     @map("banner_link")
  bannerBgColor         String?     @map("banner_bg_color")
  bannerActive          Boolean     @default(false) @map("banner_active")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  storeProducts StoreProduct[]
  customers     Customer[]
  orders        Order[]
  ledgerEntries LedgerEntry[]
  reviews       Review[]
  coupons       Coupon[]
  funnelEvents  StoreFunnelEvent[]

  @@index([studentId])
  @@index([status])
  @@map("stores")
}

model Category {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  parentId       String?         @map("parent_id")
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryHierarchy")
  masterProducts MasterProduct[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model MasterProduct {
  id                String   @id @default(uuid())
  sku               String   @unique
  title             String
  categoryId        String   @map("category_id")
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  basePrice         Decimal  @map("base_price") @db.Decimal(10, 2)
  stockQuantity     Int      @default(0) @map("stock_quantity")
  masterDescription String   @map("master_description") @db.Text
  masterImages      String[] @default([]) @map("master_images")
  isActive          Boolean  @default(true) @map("is_active")
  ratingAvg         Decimal  @default(0.0) @map("rating_avg") @db.Decimal(3, 2)
  totalReviewsCount Int      @default(0) @map("total_reviews_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  storeProducts StoreProduct[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@index([categoryId])
  @@index([isActive])
  @@map("master_products")
}

model StoreProduct {
  id                String        @id @default(uuid())
  storeId           String        @map("store_id")
  store             Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  masterProductId   String        @map("master_product_id")
  masterProduct     MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  sellingPrice      Decimal       @map("selling_price") @db.Decimal(10, 2)
  compareAtPrice    Decimal?      @map("compare_at_price") @db.Decimal(10, 2)
  customTitle       String?       @map("custom_title")
  customDescription String?       @map("custom_description") @db.Text
  customImages      String[]      @default([]) @map("custom_images")
  tags              String[]      @default([])
  isFeatured        Boolean       @default(false) @map("is_featured")
  isVisible         Boolean       @default(true) @map("is_visible")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@unique([storeId, masterProductId])
  @@index([storeId])
  @@index([isVisible])
  @@map("store_products")
}

model Customer {
  id               String   @id @default(uuid())
  storeId          String   @map("store_id")
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fullName         String   @map("full_name")
  phone            String
  email            String?
  addresses        Json     @default("[]")
  totalOrdersCount Int      @default(0) @map("total_orders_count")
  totalSpend       Decimal  @default(0.0) @map("total_spend") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  orders  Order[]
  reviews Review[]

  @@unique([storeId, phone])
  @@index([storeId])
  @@map("customers")
}

model Order {
  id                  String      @id @default(uuid())
  storeId             String      @map("store_id")
  store               Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customerId          String      @map("customer_id")
  customer            Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderNumber         String      @unique @map("order_number")
  subtotal            Decimal     @db.Decimal(10, 2)
  shippingFee         Decimal     @default(0.0) @map("shipping_fee") @db.Decimal(10, 2)
  discountAmount      Decimal     @default(0.0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount         Decimal     @map("total_amount") @db.Decimal(10, 2)
  totalBaseCost       Decimal     @default(0.0) @map("total_base_cost") @db.Decimal(10, 2)
  platformCommission  Decimal     @default(0.0) @map("platform_commission") @db.Decimal(10, 2)
  paymentFee          Decimal     @default(0.0) @map("payment_fee") @db.Decimal(10, 2)
  studentNetProfit    Decimal     @default(0.0) @map("student_net_profit") @db.Decimal(10, 2)
  status              OrderStatus @default(PENDING_PAYMENT)
  paymentMethod       String      @default("COD") @map("payment_method")
  paymentStatus       String      @default("UNPAID") @map("payment_status")
  shippingAddress     Json        @map("shipping_address")
  trackingNumber      String?     @map("tracking_number")
  courierName         String?     @map("courier_name")
  reviewToken         String?     @unique @map("review_token")
  reviewRequestSentAt DateTime?   @map("review_request_sent_at")
  couponId            String?     @map("coupon_id")
  coupon              Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode          String?     @map("coupon_code")
  utmSource           String?     @map("utm_source")
  utmMedium           String?     @map("utm_medium")
  utmCampaign         String?     @map("utm_campaign")
  referralCode        String?     @map("referral_code")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  items         OrderItem[]
  ledgerEntries LedgerEntry[]
  reviews       Review[]

  @@index([storeId])
  @@index([customerId])
  @@index([couponId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeProductId   String?       @map("store_product_id")
  storeProduct     StoreProduct? @relation(fields: [storeProductId], references: [id], onDelete: SetNull)
  masterProductId  String        @map("master_product_id")
  masterProduct    MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  quantity         Int
  unitBasePrice    Decimal       @map("unit_base_price") @db.Decimal(10, 2)
  unitSellingPrice Decimal       @map("unit_selling_price") @db.Decimal(10, 2)
  totalPrice       Decimal       @map("total_price") @db.Decimal(10, 2)
  createdAt        DateTime      @default(now()) @map("created_at")

  @@map("order_items")
}

model LedgerEntry {
  id           String          @id @default(uuid())
  storeId      String          @map("store_id")
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  orderId      String?         @map("order_id")
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  entryType    LedgerEntryType @map("entry_type")
  amount       Decimal         @db.Decimal(10, 2)
  balanceAfter Decimal         @map("balance_after") @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([storeId])
  @@map("ledger_entries")
}

model Review {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  masterProductId String        @map("master_product_id")
  masterProduct   MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  storeId         String        @map("store_id")
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId      String        @map("customer_id")
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  productRating  Int @map("product_rating")
  storeRating    Int @map("store_rating")
  deliveryRating Int @map("delivery_rating")

  productComment  String? @map("product_comment") @db.Text
  storeComment    String? @map("store_comment") @db.Text
  deliveryComment String? @map("delivery_comment") @db.Text

  isVerified  Boolean @default(true) @map("is_verified")
  isPublished Boolean @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, masterProductId])
  @@index([masterProductId])
  @@index([storeId])
  @@index([customerId])
  @@index([isPublished])
  @@map("reviews")
}

model Challenge {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  description   String   @db.Text
  requiredEvent String   @map("required_event")
  threshold     Int      @default(1)
  tierLevel     Int      @default(1) @map("tier_level")
  xpReward      Int      @default(100) @map("xp_reward")
  badgeIcon     String?  @map("badge_icon")
  createdAt     DateTime @default(now()) @map("created_at")

  studentProgresses StudentProgress[]

  @@map("challenges")
}

model StudentProgress {
  id           String    @id @default(uuid())
  studentId    String    @map("student_id")
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  challengeId  String    @map("challenge_id")
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  currentCount Int       @default(0) @map("current_count")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  isClaimed    Boolean   @default(false) @map("is_claimed")
  claimedAt    DateTime? @map("claimed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([studentId, challengeId])
  @@index([studentId])
  @@index([challengeId])
  @@map("student_progresses")
}

model StudentLevel {
  studentId     String   @id @map("student_id")
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentLevel  Int      @default(1) @map("current_level")
  totalXp       Int      @default(0) @map("total_xp")
  levelTitle    String   @default("Store Starter") @map("level_title")
  unlockedPerks String[] @default([]) @map("unlocked_perks")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("student_levels")
}

model Coupon {
  id            String             @id @default(uuid())
  storeId       String             @map("store_id")
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String
  discountType  CouponDiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal            @map("discount_value") @db.Decimal(10, 2)
  minSpend      Decimal            @default(0.0) @map("min_spend") @db.Decimal(10, 2)
  maxUses       Int?               @map("max_uses")
  usedCount     Int                @default(0) @map("used_count")
  startDate     DateTime           @default(now()) @map("start_date")
  endDate       DateTime?          @map("end_date")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  orders Order[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([code])
  @@map("coupons")
}

model StoreFunnelEvent {
  id        String          @id @default(uuid())
  storeId   String          @map("store_id")
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessionId String          @map("session_id")
  eventType FunnelEventType @map("event_type")
  entityId  String?         @map("entity_id")
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([storeId, eventType, createdAt])
  @@index([sessionId])
  @@map("store_funnel_events")
}

