}

enum ExchangeStatus {
  NEW
  INVOICED
  HOLD
  IN_COURIER
  COMPLETE
  CANCELLED
}

enum ReturnGrading {
  RESELLABLE
  DAMAGED
}

model ExchangeOrder {
  id                    String         @id @default(uuid())
  exchangeNumber        String         @unique @map("exchange_number")
  originalOrderId       String         @map("original_order_id")
  originalOrder         Order          @relation(fields: [originalOrderId], references: [id], onDelete: Restrict)
  returnedProductId     String         @map("returned_product_id")
  returnedProduct       MasterProduct  @relation("ExchangeReturnedProduct", fields: [returnedProductId], references: [id], onDelete: Restrict)
  replacementProductId  String         @map("replacement_product_id")
  replacementProduct    MasterProduct  @relation("ExchangeReplacementProduct", fields: [replacementProductId], references: [id], onDelete: Restrict)
  quantity              Int            @default(1)
  reason                String
  status                ExchangeStatus @default(NEW)
  proofPhotos           String[]       @default([]) @map("proof_photos")
  // Positive: customer owes the difference; negative: credit note issued.
  differenceAmount      Decimal        @default(0.0) @map("difference_amount") @db.Decimal(10, 2)
  returnDeliveryFee     Decimal        @default(0.0) @map("return_delivery_fee") @db.Decimal(10, 2)
  settlementType        String?        @map("settlement_type")
  stockReserved         Boolean        @default(false) @map("stock_reserved")
  grading               ReturnGrading?
  inspectedAt           DateTime?      @map("inspected_at")
  courierName           String?        @map("courier_name")
  reverseTrackingNumber String?        @map("reverse_tracking_number")
  forwardTrackingNumber String?        @map("forward_tracking_number")
  notes                 String?
  createdById           String?        @map("created_by_id")
  completedAt           DateTime?      @map("completed_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@index([originalOrderId])
  @@map("exchange_orders")
}

