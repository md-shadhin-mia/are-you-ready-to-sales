  masterProduct    MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  quantityOrdered  Int           @map("quantity_ordered")
  quantityReceived Int           @default(0) @map("quantity_received")
  unitCost         Decimal       @map("unit_cost") @db.Decimal(10, 2)

  receiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([masterProductId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  grnNumber       String        @unique @map("grn_number")
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedById    String?       @map("received_by_id")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")

  items GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  goodsReceiptId      String            @map("goods_receipt_id")
