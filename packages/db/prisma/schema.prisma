  status       CommissionStatus @default(PENDING)
  notes        String?
  approvedById String?          @map("approved_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@index([orderId])
  @@map("employee_commissions")
}

enum PenaltyStatus {
  PENDING
  APPROVED
  REJECTED
}

model EmployeePenalty {
  id              String        @id @default(uuid())
  employeeId      String        @map("employee_id")
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(12, 2)
  infractionCode  String        @map("infraction_code")
  description     String?
  supervisorNotes String        @map("supervisor_notes")
  status          PenaltyStatus @default(PENDING)
  // Billing month in YYYY-MM form.
  effectiveMonth  String        @map("effective_month")
  approvedById    String?       @map("approved_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@index([effectiveMonth])
  @@map("employee_penalties")
}

enum SalarySheetStatus {
  DRAFT
  FINALIZED
}

model SalarySheet {
  id               String            @id @default(uuid())
  // Billing month in YYYY-MM form.
  month            String            @unique
  status           SalarySheetStatus @default(DRAFT)
  totalBase        Decimal           @default(0.0) @map("total_base") @db.Decimal(14, 2)
  totalCommissions Decimal           @default(0.0) @map("total_commissions") @db.Decimal(14, 2)
  totalPenalties   Decimal           @default(0.0) @map("total_penalties") @db.Decimal(14, 2)
  totalNetPayable  Decimal           @default(0.0) @map("total_net_payable") @db.Decimal(14, 2)
  generatedById    String?           @map("generated_by_id")
  finalizedById    String?           @map("finalized_by_id")
  finalizedAt      DateTime?         @map("finalized_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  lines SalarySheetLine[]

  @@map("salary_sheets")
}

model SalarySheetLine {
  id            String      @id @default(uuid())
  salarySheetId String      @map("salary_sheet_id")
  salarySheet   SalarySheet @relation(fields: [salarySheetId], references: [id], onDelete: Cascade)
  employeeId    String      @map("employee_id")
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  baseSalary    Decimal     @map("base_salary") @db.Decimal(12, 2)
  commissions   Decimal     @db.Decimal(12, 2)
  penalties     Decimal     @db.Decimal(12, 2)
  netPayable    Decimal     @map("net_payable") @db.Decimal(12, 2)

  @@unique([salarySheetId, employeeId])
  @@map("salary_sheet_lines")
}

// ---------------------------------------------------------------------
// Site settings & CMS
// ---------------------------------------------------------------------

// Singleton row (id is pinned to 'singleton' by a CHECK constraint).
model SiteSetting {
  id                  String   @id @default("singleton")
  siteName            String   @map("site_name")
  tagline             String?
  logoUrl             String?  @map("logo_url")
  faviconUrl          String?  @map("favicon_url")
  supportEmail        String?  @map("support_email")
  supportPhone        String?  @map("support_phone")
  address             String?
  socialLinks         Json     @default("{}") @map("social_links")
  // AES-256-GCM encrypted JSON blobs; write-only via the API.
  encryptedApiSecrets String?  @map("encrypted_api_secrets") @db.Text
  encryptedWebhooks   String?  @map("encrypted_webhooks") @db.Text
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model CmsPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  contentHtml     String   @map("content_html") @db.Text
  metaDescription String?  @map("meta_description")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("cms_pages")
}

// Singleton row (id is pinned to 'singleton' by a CHECK constraint).
model AboutContent {
  id             String   @id @default("singleton")
  headline       String
  story          String   @db.Text
  mission        String?  @db.Text
  vision         String?  @db.Text
  leadershipTeam Json     @default("[]") @map("leadership_team")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("about_content")
}

model PlatformBanner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  placement String   @default("HOME_HERO")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, startDate, endDate])
  @@map("platform_banners")
}

// Full-text search uses the GIN expression index "faqs_search_idx" created in raw SQL.
model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}
