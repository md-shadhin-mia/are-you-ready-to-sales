  supplier        Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String?            @map("purchase_order_id")
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  masterProductId String             @map("master_product_id")
  masterProduct   MasterProduct      @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  returnTypeId    String             @map("return_type_id")
  returnType      PurchaseReturnType @relation(fields: [returnTypeId], references: [id], onDelete: Restrict)
  quantity        Int
  unitCost        Decimal            @map("unit_cost") @db.Decimal(10, 2)
  notes           String?
  createdById     String?            @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")

  @@index([supplierId])
  @@map("purchase_returns")
}

